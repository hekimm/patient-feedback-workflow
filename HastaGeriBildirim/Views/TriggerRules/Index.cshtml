@model List<TriggerRule>
@{
    ViewData["Title"] = "Tetikleme Kuralları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-gear"></i> Tetikleme Kuralları</h2>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Olay</th>
                        <th>Şablon</th>
                        <th>Kanal</th>
                        <th class="text-center">Gecikme</th>
                        <th class="text-center">Eşik</th>
                        <th class="text-center">Frequency Cap</th>
                        <th class="text-center">Hatırlatma</th>
                        <th class="text-center">SLA</th>
                        <th class="text-center">Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in Model)
                    {
                        <tr>
                            <td><span class="badge bg-info">@rule.EventType</span></td>
                            <td>@rule.TemplateName</td>
                            <td>
                                <div>@rule.PrimaryChannelName</div>
                                @if (!string.IsNullOrEmpty(rule.FallbackChannelName))
                                {
                                    <small class="text-muted">Yedek: @rule.FallbackChannelName</small>
                                }
                            </td>
                            <td class="text-center">@rule.DelayMinutes dk</td>
                            <td class="text-center">@rule.LowScoreThreshold.ToString("F1")</td>
                            <td class="text-center">@rule.FrequencyCapCount / @rule.FrequencyCapDays gün</td>
                            <td class="text-center">
                                @(rule.ReminderEnabled ? $"{rule.ReminderCount} x {rule.ReminderIntervalMinutes} dk" : "Kapalı")
                            </td>
                            <td class="text-center">@rule.ServiceRecoverySlaHours saat</td>
                            <td class="text-center">
                                <span class="badge bg-@(rule.IsEnabled ? "success" : "secondary")">
                                    @(rule.IsEnabled ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@rule.TriggerRuleId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </a>
                                <form asp-action="Toggle" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@rule.TriggerRuleId" />
                                    <input type="hidden" name="enable" value="@(!rule.IsEnabled)" />
                                    <button type="submit" class="btn btn-sm @(rule.IsEnabled ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(rule.IsEnabled ? "Pasifleştir" : "Aktifleştir")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info">Kayıt bulunamadı.</div>
        }
    </div>
</div>

