@model CloseCaseViewModel
@{
    ViewData["Title"] = "Hizmet Telafisi Kapat";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-check-circle"></i> Case #@Model.CaseId Kapat</h2>
    <a asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<form asp-action="Close" method="post" class="card">
    <div class="card-body">
        <input type="hidden" asp-for="CaseId" />
        <label asp-for="ClosureNote" class="form-label">Kapatma Notu</label>
        <textarea asp-for="ClosureNote" class="form-control" rows="5" required maxlength="1000"></textarea>
        <span asp-validation-for="ClosureNote" class="text-danger"></span>
    </div>
    <div class="card-footer text-end">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Kapat
        </button>
    </div>
</form>

