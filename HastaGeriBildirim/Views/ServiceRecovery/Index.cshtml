@model ServiceRecoveryListViewModel
@{
    ViewData["Title"] = "Hizmet Telafisi";
}

<h2><i class="bi bi-tools"></i> Hizmet Telafisi Yönetimi</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h6>Açık Case'ler</h6>
                <h2 class="mb-0">@Model.OpenCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h6>SLA Yaklaşan</h6>
                <h2 class="mb-0">@Model.SlaWarningCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h6>SLA Aşan</h6>
                <h2 class="mb-0">@Model.SlaBreachCount</h2>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Case ID</th>
                        <th>Hasta</th>
                        <th>Bölüm</th>
                        <th class="text-center">Puan</th>
                        <th>Atanan</th>
                        <th>Durum</th>
                        <th>Öncelik</th>
                        <th>SLA</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Cases)
                    {
                        <tr class="@(c.IsSlaBreached ? "table-danger" : c.IsSlaWarning ? "table-warning" : "")">
                            <td>@c.CaseId</td>
                            <td>@c.PatientName</td>
                            <td>@c.DepartmentName</td>
                            <td class="text-center">
                                <span class="badge bg-danger">@c.OverallScore?.ToString("F1")</span>
                            </td>
                            <td>@(c.AssignedToName ?? "Atanmamış")</td>
                            <td>
                                <span class="badge bg-@(c.Status == "OPEN" ? "primary" : c.Status == "IN_PROGRESS" ? "info" : "success")">
                                    @c.Status
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@(c.Priority == "HIGH" ? "danger" : c.Priority == "MEDIUM" ? "warning" : "secondary")">
                                    @c.Priority
                                </span>
                            </td>
                            <td>
                                @if (c.IsSlaBreached)
                                {
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Aşıldı</span>
                                }
                                else if (c.IsSlaWarning)
                                {
                                    <span class="text-warning"><i class="bi bi-clock"></i> @c.HoursRemaining saat</span>
                                }
                                else
                                {
                                    <span class="text-muted">@c.HoursRemaining saat</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@c.CaseId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Cases.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Açık hizmet telafisi case'i bulunmuyor.
            </div>
        }
    </div>
</div>
