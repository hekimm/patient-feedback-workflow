@model AddActionViewModel
@{
    ViewData["Title"] = "Aksiyon Ekle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-plus-circle"></i> Aksiyon Ekle</h2>
    <a asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="AddAction" method="post">
                    <input type="hidden" asp-for="CaseId" />
                    
                    <div class="mb-3">
                        <label asp-for="ActionNote" class="form-label">Aksiyon Notu</label>
                        <textarea asp-for="ActionNote" class="form-control" rows="5" 
                                  placeholder="Yapılan işlem veya alınan aksiyonu detaylı olarak açıklayın..." required></textarea>
                        <span asp-validation-for="ActionNote" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Aksiyon Kaydet
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.CaseId" class="btn btn-outline-secondary">
                            İptal
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
