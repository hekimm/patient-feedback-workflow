@model SurveyStartViewModel
@{
    Layout = null;
    var lang = Model.Lang;
}

<!DOCTYPE html>
<html lang="@lang" dir="@(lang == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SurveyTexts.Get(lang, "welcome_title")</title>
    <link rel="stylesheet" href="~/css/survey.css" asp-append-version="true" />
</head>
<body class="survey-body">
    <main class="survey-shell">
        @await Html.PartialAsync("_SurveyBrand")
        <div class="survey-card survey-center">
            <nav class="survey-lang" aria-label="Dil seçimi">
                <a asp-action="Start" asp-route-token="@Model.Token" asp-route-lang="tr"
                   class="survey-btn @(lang == "tr" ? "" : "secondary")">Türkçe</a>
                <a asp-action="Start" asp-route-token="@Model.Token" asp-route-lang="en"
                   class="survey-btn @(lang == "en" ? "" : "secondary")">English</a>
                <a asp-action="Start" asp-route-token="@Model.Token" asp-route-lang="ar"
                   class="survey-btn @(lang == "ar" ? "" : "secondary")">العربية</a>
            </nav>

            <h1 class="survey-title">@SurveyTexts.Get(lang, "welcome_title")</h1>
            <p class="survey-lead survey-muted">@SurveyTexts.Get(lang, "welcome_text")</p>
            <div class="survey-actions">
                <a asp-action="Consent" asp-route-token="@Model.Token" asp-route-lang="@lang"
                   class="survey-btn">
                    @SurveyTexts.Get(lang, "start_button")
                </a>
            </div>
        </div>
    </main>
</body>
</html>
