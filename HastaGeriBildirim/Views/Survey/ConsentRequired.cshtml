@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rıza Gerekli</title>
    <link rel="stylesheet" href="~/css/survey.css" asp-append-version="true" />
</head>
<body class="survey-body">
    <main class="survey-shell">
        @await Html.PartialAsync("_SurveyBrand")
        <div class="survey-card survey-center">
            <h1 class="survey-title">KVKK Rızası Gerekli</h1>
            <p class="survey-lead survey-muted">
                Ankete devam edebilmek için KVKK aydınlatma metnini okumanız ve açık rıza vermeniz gerekmektedir.
            </p>
            <p class="survey-muted">Lütfen geri dönerek rıza onayını işaretleyin.</p>
        </div>
    </main>
</body>
</html>
