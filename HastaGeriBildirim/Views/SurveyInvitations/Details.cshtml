@model InvitationDetailViewModel
@{
    ViewData["Title"] = "Davet Detayı";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-envelope"></i> Davet #@Model.Invitation.InvitationId</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

@if (!string.IsNullOrEmpty(Model.FreshSurveyLink))
{
    <div class="alert alert-success">
        <h5>Yeni tek kullanımlık bağlantı</h5>
        <div class="input-group mb-3">
            <input class="form-control" readonly value="@Model.FreshSurveyLink" />
            <a href="@Model.FreshSurveyLink" target="_blank" class="btn btn-outline-primary">Aç</a>
        </div>
        @if (!string.IsNullOrEmpty(Model.FreshQrSvg))
        {
            <div class="bg-white border rounded p-3 d-inline-block" style="max-width:220px">
                @Html.Raw(Model.FreshQrSvg)
            </div>
        }
    </div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Davet Bilgileri</h5>
            </div>
            <div class="card-body">
                <p><strong>Hasta:</strong> @Model.Invitation.PatientName</p>
                <p><strong>Olay:</strong> @Model.Invitation.EventType</p>
                <p><strong>Şablon:</strong> @Model.Invitation.TemplateName</p>
                <p><strong>Kanal:</strong> @Model.Invitation.ChannelName</p>
                <p><strong>Durum:</strong> @Model.Invitation.Status</p>
                <p><strong>Oluşturma:</strong> @Model.Invitation.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                <p><strong>Gönderim:</strong> @(Model.Invitation.SentAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>
                <p><strong>Tamamlanma:</strong> @(Model.Invitation.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</p>
                <p><strong>Son Kullanım:</strong> @Model.Invitation.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</p>
            </div>
            <div class="card-footer">
                <form asp-action="RegenerateLink" asp-route-id="@Model.Invitation.InvitationId" method="post">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-qr-code"></i> Link / QR Yenile
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Teslimat Denemeleri</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Kanal</th>
                                <th>Durum</th>
                                <th>Gönderim</th>
                                <th>Hata</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attempt in Model.DeliveryAttempts)
                            {
                                <tr>
                                    <td>@attempt.AttemptNo</td>
                                    <td>@attempt.ChannelName</td>
                                    <td>
                                        <span class="badge bg-@(attempt.DeliveryStatus == "SENT" ? "success" : "danger")">
                                            @attempt.DeliveryStatus
                                        </span>
                                    </td>
                                    <td>@(attempt.SentAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                    <td>@(attempt.ErrorMessage ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.DeliveryAttempts.Any())
                {
                    <div class="alert alert-info">Henüz teslimat denemesi yok.</div>
                }
            </div>
        </div>
    </div>
</div>

