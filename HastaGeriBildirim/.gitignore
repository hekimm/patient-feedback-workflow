## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015 cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/

# Others
*.log
*.cache
*.lock.json
project.lock.json
project.fragment.lock.json
artifacts/

# VS Code
.vscode/

# Rider
.idea/
*.sln.iml

# Mac
.DS_Store

# Sensitive data
appsettings.Development.json
appsettings.Local.json
secrets.json
